NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DB_FILE=./data/wellora.sqlite

# Generic authenticated SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM="Wellora <newsletter@your-domain.com>"
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=20000

# Protects POST /api/admin/smtp-test. Generate a long random secret.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Brevo example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-google-account@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# Gmail usually requires 2-Step Verification and an App Password.
